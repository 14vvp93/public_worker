<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:id="@+id/device_item"
    android:paddingBottom="@dimen/x1"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/y48"
    android:layout_marginStart="@dimen/x5">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/device_item_text"
        android:paddingBottom="@dimen/x1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:paddingStart="@dimen/x3">
        <TextView
            android:textSize="@dimen/x21"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/item_remote_device_name"
            android:layout_width="@dimen/x290"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x20"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/x26"
            android:textColor="@color/color_blue_dark"
            android:id="@+id/item_remote_connect_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/x26"
            android:id="@+id/item_remote_device_macaddr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/device_select"
            android:background="@drawable/set_rb_off"
            android:layout_width="@dimen/x48"
            android:layout_height="@dimen/x48"
            android:layout_marginStart="@dimen/x8"/>
    </LinearLayout>
    <Button
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_config_profile"
        android:background="@drawable/more"
        android:layout_width="@dimen/x48"
        android:layout_height="@dimen/x48"
        android:layout_marginStart="@dimen/x20"
        android:layout_marginEnd="@dimen/x20"/>
</LinearLayout>
