<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:background="@drawable/bg"
    android:fitsSystemWindows="true"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/set_device_bg"
        android:layout_width="704dp"
        android:layout_height="548dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="32dp">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="60dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginStart="60dp">
                <ImageView
                    android:background="@drawable/poster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginStart="35dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/music"
                        android:layout_marginStart="20dp"/>
                    <TextView
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_blue_dark"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_music_title"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:layout_width="@dimen/x320"
                        android:layout_height="wrap_content"
                        android:text="@string/str_music_title"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginStart="22dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <ImageView
                        android:id="@+id/iv_music_icon_album"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/album"
                        android:layout_marginStart="20dp"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/color_blue_dark"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_music_icon_album"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:layout_width="@dimen/x320"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginStart="22dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <ImageView
                        android:id="@+id/iv_music_icon_artist"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/actors"
                        android:layout_marginStart="20dp"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/color_blue_dark"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_music_icon_artist"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:layout_width="@dimen/x320"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginStart="22dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/color_blue_dark"
                android:id="@+id/tv_music_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/music_playing_time"/>
            <ProgressBar
                android:id="@+id/tv_music_playing_progress"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:progress="12"
                android:progressDrawable="@drawable/seekbar_bg"
                android:layout_weight="8"
                android:layout_marginStart="15dp"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/color_blue_dark"
                android:id="@+id/tv_music_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/music_total_time"
                android:layout_marginStart="15dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="15dp">
            <Button
                android:id="@+id/btn_music_prev"
                android:background="@drawable/music_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/btn_music_pause"
                android:background="@drawable/music_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"/>
            <Button
                android:id="@+id/btn_music_play"
                android:background="@drawable/music_play"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"/>
            <Button
                android:id="@+id/btn_music_next"
                android:background="@drawable/music_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ImageView
            android:id="@+id/bt_connect_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="5dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="0dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_a2dp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="5dp"
                    android:text="@string/a2dp_status_title"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_A2DP_status"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="0dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_avrcp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:text="@string/avrcp_status_title"
                    android:layout_marginStart="0dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_AVRCP_status"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
