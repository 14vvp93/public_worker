<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:id="@+id/device_item"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginStart="5dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/device_item_text"
        android:paddingBottom="1dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="3dp">
        <TextView
            android:textSize="21sp"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/item_remote_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="26sp"
            android:textColor="@color/color_blue_dark"
            android:id="@+id/item_remote_connect_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="26sp"
            android:id="@+id/item_remote_device_macaddr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/device_select"
            android:background="@drawable/set_rb_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <Button
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_config_profile"
        android:background="@drawable/more"
        android:layout_width="@dimen/x43"
        android:layout_height="@dimen/x49"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</LinearLayout>
