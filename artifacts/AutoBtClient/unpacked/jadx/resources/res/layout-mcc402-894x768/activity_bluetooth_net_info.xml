<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/x25"
        android:paddingEnd="@dimen/x25">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/top_frame_bg"
            android:layout_width="550dp"
            android:layout_height="89dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView1"
                android:background="@drawable/bluetooth_setup_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_green_dark"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/info1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:maxWidth="670dp"
                android:text="@string/title_1"
                android:singleLine="true"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
        <Button
            android:textSize="23sp"
            android:textColor="@color/bluetooth_close_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tips_close"
            android:background="@drawable/set_btn_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:text="@string/next"
            android:singleLine="true"
            android:shadowRadius="0.6"
            android:layout_marginStart="@dimen/x10"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/set_device_bg"
        android:layout_width="704dp"
        android:layout_height="0dp"
        android:divider="@drawable/line"
        android:layout_weight="1"
        android:showDividers="end|middle"
        android:paddingStart="@dimen/x10"
        android:paddingEnd="@dimen/x10">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/bluetooth_android"
                android:layout_marginStart="35dp"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/android_system"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="50dp">
            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_bt_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openphonebluetoot"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="50dp">
            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_input_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="380dp"
                android:text="@string/inputnetwork"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="50dp">
            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_open_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:ellipsize="end"
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="380dp"
                android:text="@string/openbtnewshare"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayout2"
        android:background="@drawable/set_device_bg"
        android:layout_width="704dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/y10"
        android:divider="@drawable/line"
        android:layout_weight="1"
        android:showDividers="end|middle"
        android:paddingStart="@dimen/x10"
        android:paddingEnd="@dimen/x10">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="25dp">
            <ImageView
                android:id="@+id/imageView2_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_apple"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView1_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ios_system"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="50dp">
            <ImageView
                android:id="@+id/imageView3_r"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/bluetooth_bt_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:ellipsize="end"
                android:id="@+id/textView2_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="380dp"
                android:text="@string/openphonebluetoot"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="50dp">
            <ImageView
                android:id="@+id/imageView4_r"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bluetooth_wifi_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:ellipsize="end"
                android:id="@+id/textView3_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="380dp"
                android:text="@string/openapplenet"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
