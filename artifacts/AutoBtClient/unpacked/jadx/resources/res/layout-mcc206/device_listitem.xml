<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/device_item"
        android:paddingBottom="@dimen/y1"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="@dimen/y45"
        android:layout_marginStart="@dimen/x30"
        android:layout_marginEnd="@dimen/x10">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/device_item_text"
            android:paddingBottom="@dimen/y1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:paddingStart="@dimen/x10">
            <TextView
                android:textSize="@dimen/x22"
                android:textColor="@color/color_blue_dark"
                android:ellipsize="end"
                android:id="@+id/item_remote_device_name"
                android:layout_width="@dimen/x250"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="@dimen/x16"
                android:textColor="@color/color_blue_dark"
                android:id="@+id/item_remote_connect_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/x10"
                android:id="@+id/item_remote_device_macaddr"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/device_select"
                android:background="@drawable/set_rb_off"
                android:layout_width="@dimen/x28"
                android:layout_height="@dimen/x28"
                android:layout_marginTop="@dimen/x2"
                android:layout_marginStart="@dimen/x8"/>
        </LinearLayout>
        <Button
            android:layout_gravity="center"
            android:id="@+id/btn_config_profile"
            android:background="@drawable/more"
            android:layout_width="@dimen/x28"
            android:layout_height="@dimen/x28"/>
    </LinearLayout>
</FrameLayout>
