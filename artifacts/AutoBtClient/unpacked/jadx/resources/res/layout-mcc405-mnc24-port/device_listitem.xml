<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/device_item"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/device_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="@dimen/x20">
        <TextView
            android:textSize="@dimen/x20"
            android:textColor="@color/bt_device_name_color"
            android:ellipsize="end"
            android:id="@+id/item_remote_device_name"
            android:layout_width="@dimen/x215"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingEnd="@dimen/x5"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/device_select"
            android:background="@drawable/set_rb_off"
            android:layout_width="@dimen/x43"
            android:layout_height="@dimen/y49"/>
    </LinearLayout>
    <Button
        android:id="@+id/btn_config_profile"
        android:background="@drawable/more"
        android:layout_width="@dimen/x46"
        android:layout_height="@dimen/y52"/>
</LinearLayout>
