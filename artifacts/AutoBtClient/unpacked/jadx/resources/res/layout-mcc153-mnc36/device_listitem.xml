<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/device_item"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/x30">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/device_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:paddingStart="@dimen/x20">
        <TextView
            android:textSize="@dimen/x22"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/item_remote_device_name"
            android:layout_width="@dimen/x280"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y13"
            android:layout_marginBottom="@dimen/y13"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/x16"
            android:textColor="@android:color/white"
            android:id="@+id/item_remote_connect_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/x10"
            android:id="@+id/item_remote_device_macaddr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/device_select"
            android:background="@drawable/set_rb_off"
            android:layout_width="@dimen/x46"
            android:layout_height="@dimen/y50"
            android:layout_marginStart="@dimen/x8"/>
    </LinearLayout>
    <Button
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_config_profile"
        android:background="@drawable/more"
        android:layout_width="@dimen/x46"
        android:layout_height="@dimen/y50"
        android:layout_marginStart="@dimen/x20"/>
</LinearLayout>
