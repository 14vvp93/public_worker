<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <EditText
                android:textSize="26sp"
                android:textColor="@android:color/white"
                android:id="@+id/search_edittext"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="flagNoFullscreen|actionDone"/>
            <Button
                android:id="@+id/bt_phonebook_syn"
                android:background="@drawable/sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/module_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">
            <GridView
                android:layout_gravity="center_horizontal"
                android:id="@+id/phonebook_listview"
                android:background="@android:color/transparent"
                android:paddingTop="22dp"
                android:layout_width="656dp"
                android:layout_height="match_parent"
                android:listSelector="@android:color/transparent"
                android:verticalSpacing="16dp"
                android:stretchMode="columnWidth"
                android:numColumns="2"
                android:choiceMode="singleChoice"
                android:paddingStart="75dp"/>
            <com.autochips.bluetooth.view.SideBar
                android:id="@+id/phonebook_sidebar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="24dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_phonebook_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/str_download_phonebook"/>
    </LinearLayout>
</FrameLayout>
