<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:src="@drawable/contact"
        android:layout_marginStart="15dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/phonebook_item"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp">
        <TextView
            android:textSize="24dp"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:id="@+id/item_phonebook_name"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:maxWidth="250dp"
            android:text="shabi"
            android:singleLine="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/color_white_light"
            android:ellipsize="end"
            android:id="@+id/item_phonebook_number"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:maxWidth="250dp"
            android:text="shabi"
            android:singleLine="true"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_phonebook_path"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bt_phonebook_path_phone"/>
    </LinearLayout>
</LinearLayout>
