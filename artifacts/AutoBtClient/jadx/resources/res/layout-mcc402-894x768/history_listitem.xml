<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:src="@drawable/contact"
        android:layout_marginStart="15dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/history_item"
        android:paddingBottom="0dp"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="5dp">
        <TextView
            android:textSize="24dp"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:layout_gravity="top"
            android:id="@+id/item_history_name"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:maxWidth="250dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/color_white_light"
            android:ellipsize="end"
            android:id="@+id/item_history_number"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="10dp"
            android:maxWidth="250dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:id="@+id/item_history_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <ImageView
            android:id="@+id/btn_call_history_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/contact"
            android:layout_marginEnd="3dp"/>
    </LinearLayout>
</LinearLayout>
