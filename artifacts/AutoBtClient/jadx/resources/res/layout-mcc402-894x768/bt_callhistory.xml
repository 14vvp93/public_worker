<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="750dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="35dp">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp">
                <RadioButton
                    android:id="@+id/btn_missed"
                    android:background="@drawable/missed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:button="@null"/>
                <RadioButton
                    android:id="@+id/btn_received"
                    android:background="@drawable/received"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:button="@null"
                    android:layout_marginStart="10dp"/>
                <RadioButton
                    android:id="@+id/btn_dialed"
                    android:background="@drawable/called"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:button="@null"
                    android:layout_marginStart="10dp"/>
                <RadioButton
                    android:id="@+id/bt_callhistory_syn"
                    android:background="@drawable/sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:button="@null"
                    android:layout_marginStart="10dp"/>
            </RadioGroup>
            <GridView
                android:id="@+id/history_listview"
                android:background="@drawable/set_device_bg"
                android:paddingLeft="50dp"
                android:paddingBottom="20dp"
                android:layout_width="704dp"
                android:layout_height="611dp"
                android:layout_marginTop="13dp"
                android:listSelector="@android:color/transparent"
                android:verticalSpacing="26dp"
                android:stretchMode="columnWidth"
                android:numColumns="2"
                android:choiceMode="singleChoice"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_callhistory_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_callhistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/callhistory_download_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_callhistory_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_download_history"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</FrameLayout>
