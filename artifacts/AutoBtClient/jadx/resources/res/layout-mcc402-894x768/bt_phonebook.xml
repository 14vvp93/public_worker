<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="750dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp">
            <EditText
                android:textSize="30sp"
                android:textColor="@color/color_blue_dark"
                android:textColorHint="@color/color_blue_dark"
                android:id="@+id/search_edittext"
                android:background="@android:color/transparent"
                android:layout_width="500dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:imeOptions="flagNoFullscreen|actionDone"/>
            <Button
                android:id="@+id/bt_phonebook_syn"
                android:background="@drawable/sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/set_device_bg"
            android:layout_width="704dp"
            android:layout_height="631dp"
            android:layout_marginTop="13dp"
            android:layout_marginStart="32dp">
            <GridView
                android:layout_gravity="center_horizontal"
                android:id="@+id/phonebook_listview"
                android:paddingLeft="40dp"
                android:layout_width="640dp"
                android:layout_height="611dp"
                android:listSelector="@android:color/transparent"
                android:verticalSpacing="26dp"
                android:stretchMode="columnWidth"
                android:numColumns="2"
                android:choiceMode="singleChoice"/>
            <com.autochips.bluetooth.view.SideBar
                android:id="@+id/phonebook_sidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_phonebook_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="30sp"
            android:textColor="@color/color_blue_dark"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_download_phonebook"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</FrameLayout>
