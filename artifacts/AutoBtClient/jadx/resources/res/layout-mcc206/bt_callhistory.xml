<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/callhistory_margin_start"
        android:layout_marginTop="@dimen/y8"
        android:layout_marginRight="@dimen/x20">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/btn_missed"
                    android:background="@drawable/missed"
                    android:layout_width="@dimen/x180"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y5"
                    android:button="@null"/>
                <RadioButton
                    android:id="@+id/btn_received"
                    android:background="@drawable/received"
                    android:layout_width="@dimen/x180"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y5"
                    android:button="@null"
                    android:layout_marginStart="@dimen/x10"/>
                <RadioButton
                    android:id="@+id/btn_dialed"
                    android:background="@drawable/called"
                    android:layout_width="@dimen/x180"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y5"
                    android:button="@null"
                    android:layout_marginStart="@dimen/x10"/>
                <RadioButton
                    android:id="@+id/bt_callhistory_syn"
                    android:background="@drawable/sync"
                    android:layout_width="@dimen/x180"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/y5"
                    android:button="@null"
                    android:layout_marginStart="@dimen/x10"/>
            </RadioGroup>
        </LinearLayout>
    </RelativeLayout>
    <ListView
        android:scrollbarThumbVertical="@drawable/bg_scroll_bar"
        android:id="@+id/history_listview"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/x138"
        android:layout_marginTop="@dimen/history_listview_layout_marginTop"
        android:layout_marginRight="@dimen/x138"
        android:listSelector="@android:color/transparent"
        android:verticalSpacing="16dp"
        android:stretchMode="columnWidth"
        android:numColumns="3"
        android:divider="@drawable/line_setting"
        android:choiceMode="singleChoice"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_callhistory_layout"
        android:background="#7f000000"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_callhistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/callhistory_download_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_callhistory_text"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/str_download_history"/>
    </LinearLayout>
</FrameLayout>
