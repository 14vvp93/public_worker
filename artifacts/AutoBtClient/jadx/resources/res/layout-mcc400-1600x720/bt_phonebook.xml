<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x70">
            <EditText
                android:textSize="@dimen/x30"
                android:textColor="@color/color_blue_dark"
                android:textColorHint="@color/color_blue_dark"
                android:id="@+id/search_edittext"
                android:background="@android:color/transparent"
                android:layout_width="@dimen/x700"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:imeOptions="flagNoFullscreen|actionDone"
                android:layout_marginStart="@dimen/x30"/>
            <Button
                android:id="@+id/bt_phonebook_syn"
                android:background="@drawable/sync"
                android:layout_width="@dimen/x116"
                android:layout_height="@dimen/y94"
                android:layout_marginStart="@dimen/x150"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x420"
            android:layout_marginStart="@dimen/x40"
            android:layout_marginEnd="@dimen/x40">
            <GridView
                android:layout_gravity="center_horizontal"
                android:id="@+id/phonebook_listview"
                android:paddingTop="@dimen/x5"
                android:paddingBottom="@dimen/x5"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y340"
                android:listSelector="@android:color/transparent"
                android:stretchMode="columnWidth"
                android:numColumns="@integer/phonebook_listview_numColumns"
                android:choiceMode="singleChoice"
                android:paddingStart="@dimen/x40"/>
            <com.autochips.bluetooth.view.SideBar
                android:id="@+id/phonebook_sidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x2"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_phonebook_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x16"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="@dimen/x30"
            android:textColor="@color/color_blue_dark"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_download_phonebook"
            android:layout_marginEnd="@dimen/x16"/>
    </LinearLayout>
</FrameLayout>
