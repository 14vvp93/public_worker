<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="@dimen/x72"
        android:layout_height="@dimen/x72"
        android:src="@drawable/contact"
        android:layout_marginEnd="@dimen/x3"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/history_item"
        android:paddingBottom="0dp"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/x5">
        <TextView
            android:textSize="@dimen/x23"
            android:textColor="@color/textview_color"
            android:ellipsize="end"
            android:id="@+id/item_history_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/x5"/>
        <TextView
            android:textSize="@dimen/x20"
            android:textColor="@color/textview_color"
            android:ellipsize="end"
            android:id="@+id/item_history_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y5"
            android:singleLine="true"
            android:layout_marginStart="@dimen/x5"/>
        <TextView
            android:textSize="@dimen/x20"
            android:textColor="@color/textview_color"
            android:ellipsize="end"
            android:id="@+id/item_history_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <ImageView
            android:id="@+id/btn_call_history_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/contact"
            android:layout_marginEnd="@dimen/x3"/>
    </LinearLayout>
</LinearLayout>
