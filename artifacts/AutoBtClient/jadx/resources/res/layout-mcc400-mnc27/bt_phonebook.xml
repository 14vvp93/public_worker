<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/x10"
        android:layout_marginStart="@dimen/x30"
        android:layout_marginEnd="@dimen/x30">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="@dimen/x19"
                android:textColor="@color/color_blue_dark"
                android:textColorHint="@color/color_blue_dark"
                android:layout_gravity="center_vertical"
                android:id="@+id/search_edittext"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:imeOptions="flagNoFullscreen|actionDone"/>
            <Button
                android:id="@+id/bt_phonebook_syn"
                android:background="@drawable/sync"
                android:layout_width="@dimen/x110"
                android:layout_height="@dimen/x54"/>
        </LinearLayout>
        <GridView
            android:layout_gravity="center_horizontal"
            android:id="@+id/phonebook_listview"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x174"
            android:layout_marginTop="@dimen/x2"
            android:listSelector="@android:color/transparent"
            android:verticalSpacing="@dimen/x16"
            android:stretchMode="columnWidth"
            android:numColumns="@integer/phonebook_listview_numColumns"
            android:choiceMode="singleChoice"
            android:layout_marginStart="@dimen/x38"
            android:layout_marginEnd="@dimen/x38"/>
        <com.autochips.bluetooth.view.SideBar
            android:id="@+id/phonebook_sidebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_phonebook_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_phonebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x15"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="@dimen/x17"
            android:textColor="@color/color_blue_dark"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_phonebook_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_download_phonebook"
            android:layout_marginEnd="@dimen/x16"/>
    </LinearLayout>
</FrameLayout>
