<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/x2"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600"
    android:paddingStart="@dimen/x46"
    android:paddingEnd="@dimen/x46">
    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/top_frame_bg"
            android:layout_width="@dimen/x417"
            android:layout_height="@dimen/x49">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView1"
                android:background="@drawable/bluetooth_setup_icon"
                android:visibility="gone"
                android:layout_width="@dimen/x45"
                android:layout_height="@dimen/x43"
                android:layout_marginStart="@dimen/x22"/>
            <TextView
                android:textSize="@dimen/x19"
                android:textColor="@color/color_green_dark"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/info1"
                android:paddingBottom="@dimen/x4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_1"
                android:singleLine="true"
                android:layout_marginStart="@dimen/x22"
                android:layout_marginEnd="@dimen/x5"/>
            <TextView
                android:textSize="@dimen/x19"
                android:textColor="@color/color_bt_net"
                android:layout_gravity="center_vertical"
                android:id="@+id/info2"
                android:paddingBottom="@dimen/x4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_2"
                android:layout_marginStart="@dimen/x22"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1"/>
        <Button
            android:textSize="@dimen/x19"
            android:textColor="@color/bluetooth_close_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tips_close"
            android:background="@drawable/set_btn_selector"
            android:paddingBottom="@dimen/x13"
            android:layout_width="@dimen/x98"
            android:layout_height="@dimen/x49"
            android:text="@string/next"
            android:singleLine="true"
            android:shadowRadius="0.6"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayout1"
        android:background="@drawable/set_device_bg"
        android:layout_width="@dimen/x417"
        android:layout_height="@dimen/x200"
        android:layout_marginTop="@dimen/x1"
        android:layout_below="@+id/linearLayout1">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x52"
            android:layout_marginStart="@dimen/x15">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView2"
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/x43"
                android:src="@drawable/bluetooth_android"/>
            <TextView
                android:textSize="@dimen/x19"
                android:textColor="@color/color_bt_net"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/android_system"
                android:layout_marginStart="@dimen/x4"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x48"
            android:layout_marginStart="@dimen/x26">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView3"
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/x43"
                android:src="@drawable/bluetooth_bt_info"/>
            <TextView
                android:textSize="@dimen/x17"
                android:textColor="@color/color_bt_net"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openphonebluetoot"
                android:alpha="0.6"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x48"
            android:layout_marginStart="@dimen/x26">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView4"
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/x43"
                android:src="@drawable/bluetooth_input_info"/>
            <TextView
                android:textSize="@dimen/x17"
                android:textColor="@color/color_bt_net"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inputnetwork"
                android:singleLine="true"
                android:alpha="0.6"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x48"
            android:layout_marginStart="@dimen/x26">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView5"
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/x43"
                android:src="@drawable/bluetooth_open_info"/>
            <TextView
                android:textSize="@dimen/x17"
                android:textColor="@color/color_bt_net"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openbtnewshare"
                android:singleLine="true"
                android:alpha="0.6"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/relativeLayout2"
        android:background="@drawable/set_device_bg"
        android:layout_width="@dimen/x417"
        android:layout_height="@dimen/x200"
        android:layout_marginTop="@dimen/x1"
        android:layout_below="@+id/linearLayout1"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x52"
            android:layout_marginStart="@dimen/x15">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView2_r"
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/x43"
                android:src="@drawable/bluetooth_apple"/>
            <TextView
                android:textSize="@dimen/x19"
                android:textColor="@color/color_bt_net"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView1_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ios_system"
                android:layout_marginStart="@dimen/x7"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x48"
            android:layout_marginStart="@dimen/x26">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView3_r"
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/x43"
                android:src="@drawable/bluetooth_bt_info"/>
            <TextView
                android:textSize="@dimen/x17"
                android:textColor="@color/color_bt_net"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView2_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openphonebluetoot"
                android:singleLine="true"
                android:alpha="0.6"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x48"
            android:layout_marginStart="@dimen/x26">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView4_r"
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/x43"
                android:src="@drawable/bluetooth_wifi_info"/>
            <TextView
                android:textSize="@dimen/x17"
                android:textColor="@color/color_bt_net"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/textView3_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openapplenet"
                android:singleLine="true"
                android:alpha="0.6"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</RelativeLayout>
