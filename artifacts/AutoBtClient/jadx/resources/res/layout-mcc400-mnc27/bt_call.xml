<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Space
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layoutDirection="ltr">
                <TableRow
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_one"
                        android:background="@drawable/dp_one"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_two"
                        android:background="@drawable/dp_two"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_three"
                        android:background="@drawable/dp_three"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_four"
                        android:background="@drawable/dp_four"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_five"
                        android:background="@drawable/dp_five"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_six"
                        android:background="@drawable/dp_six"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"/>
                </TableRow>
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_seven"
                        android:background="@drawable/dp_seven"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_eight"
                        android:background="@drawable/dp_eight"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_nine"
                        android:background="@drawable/dp_nine"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"/>
                </TableRow>
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_pound"
                        android:background="@drawable/dp_sharp"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_zero"
                        android:background="@drawable/dp_zero"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"
                        android:layout_marginEnd="@dimen/x20"/>
                    <Button
                        android:id="@+id/btn_call_asterisk"
                        android:background="@drawable/dp_star"
                        android:layout_width="@dimen/x114"
                        android:layout_height="@dimen/x64"/>
                </TableRow>
            </TableLayout>
        </RelativeLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/call_bg"
            android:padding="@dimen/x3"
            android:layout_width="@dimen/x384"
            android:layout_height="@dimen/x256">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x56"
                android:layout_marginStart="@dimen/x52"
                android:layout_marginEnd="@dimen/x25">
                <EditText
                    android:textSize="@dimen/x32"
                    android:textColor="@color/color_blue_dark"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/text_call_info"
                    android:background="@android:color/transparent"
                    android:layout_width="@dimen/x252"
                    android:layout_height="match_parent"
                    android:singleLine="true"/>
                <Button
                    android:layout_gravity="center"
                    android:id="@+id/btn_del_num"
                    android:background="@drawable/backspace"
                    android:layout_width="@dimen/x56"
                    android:layout_height="@dimen/x56"/>
            </LinearLayout>
            <TextView
                android:background="@drawable/line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <ListView
                android:id="@+id/listview_calls"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x119"
                android:divider="@drawable/line"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x4">
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btn_call"
                    android:background="@drawable/call"
                    android:layout_width="@dimen/x75"
                    android:layout_height="@dimen/x75"/>
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
