<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/y46"
        android:layout_marginBottom="@dimen/y98"
        android:layout_marginStart="@dimen/x45"
        android:layout_marginEnd="@dimen/x45">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr">
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x20">
                    <Button
                        android:id="@+id/btn_call_one"
                        android:background="@drawable/dp_one"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_two"
                        android:background="@drawable/dp_two"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_three"
                        android:background="@drawable/dp_three"
                        android:layout_width="192dp"
                        android:layout_height="85dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x20">
                    <Button
                        android:id="@+id/btn_call_four"
                        android:background="@drawable/dp_four"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_five"
                        android:background="@drawable/dp_five"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_six"
                        android:background="@drawable/dp_six"
                        android:layout_width="192dp"
                        android:layout_height="85dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x20">
                    <Button
                        android:id="@+id/btn_call_seven"
                        android:background="@drawable/dp_seven"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_eight"
                        android:background="@drawable/dp_eight"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_nine"
                        android:background="@drawable/dp_nine"
                        android:layout_width="192dp"
                        android:layout_height="85dp"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_asterisk"
                        android:background="@drawable/dp_star"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_zero"
                        android:background="@drawable/dp_zero"
                        android:layout_width="192dp"
                        android:layout_height="85dp"
                        android:layout_marginEnd="@dimen/x26"/>
                    <Button
                        android:id="@+id/btn_call_pound"
                        android:background="@drawable/dp_sharp"
                        android:layout_width="192dp"
                        android:layout_height="85dp"/>
                </TableRow>
            </TableLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/setting_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/x56">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/y64">
                <EditText
                    android:textSize="@dimen/x34"
                    android:textColor="@android:color/white"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/text_call_info"
                    android:background="@android:color/transparent"
                    android:layout_width="@dimen/x520"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/x20"/>
                <Button
                    android:layout_gravity="center"
                    android:id="@+id/btn_del_num"
                    android:background="@drawable/backspace"
                    android:layout_width="@dimen/x48"
                    android:layout_height="@dimen/x48"
                    android:layout_marginStart="@dimen/x20"/>
            </LinearLayout>
            <View
                android:background="@drawable/line"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
            <ListView
                android:id="@+id/listview_calls"
                android:layout_width="match_parent"
                android:layout_height="187dp"
                android:divider="@drawable/line"
                android:dividerHeight="2dp"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp">
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btn_call"
                    android:background="@drawable/call"
                    android:layout_width="92dp"
                    android:layout_height="92dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
