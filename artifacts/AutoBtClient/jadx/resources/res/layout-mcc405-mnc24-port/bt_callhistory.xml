<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/x84"
        android:layout_marginStart="@dimen/x20"
        android:layout_marginEnd="@dimen/x20">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/y42">
                <RadioButton
                    android:id="@+id/btn_missed"
                    android:background="@drawable/missed"
                    android:layout_width="@dimen/x131"
                    android:layout_height="@dimen/y70"
                    android:button="@null"
                    android:layout_weight="1"/>
                <RadioButton
                    android:id="@+id/btn_received"
                    android:background="@drawable/received"
                    android:layout_width="@dimen/x131"
                    android:layout_height="@dimen/y70"
                    android:button="@null"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/x20"/>
                <RadioButton
                    android:id="@+id/btn_dialed"
                    android:background="@drawable/called"
                    android:layout_width="@dimen/x131"
                    android:layout_height="@dimen/y70"
                    android:button="@null"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/x20"/>
                <RadioButton
                    android:id="@+id/bt_callhistory_syn"
                    android:background="@drawable/sync"
                    android:layout_width="@dimen/x131"
                    android:layout_height="@dimen/y70"
                    android:button="@null"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/x20"/>
            </RadioGroup>
            <GridView
                android:id="@+id/history_listview"
                android:background="@drawable/bt_contactphone_bg"
                android:paddingTop="@dimen/x5"
                android:paddingBottom="@dimen/x5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/y533"
                android:listSelector="@android:color/transparent"
                android:horizontalSpacing="@dimen/x45"
                android:verticalSpacing="@dimen/x38"
                android:stretchMode="columnWidth"
                android:numColumns="2"
                android:choiceMode="singleChoice"
                android:paddingStart="@dimen/x35"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_callhistory_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_callhistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x16"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="@dimen/x20"
            android:textColor="@color/callhistory_download_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_callhistory_text"
            android:layout_width="@dimen/x200"
            android:layout_height="wrap_content"
            android:text="@string/str_download_history"/>
    </LinearLayout>
</FrameLayout>
