<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_main"
    android:background="@drawable/bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autochips.bluetooth.adapter.EnableScrollViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/bottom_menu"
        android:background="@drawable/bg_dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/acivity_main_bottom_menu_layout_height">
        <ImageView
            android:gravity="center"
            android:id="@+id/btn_telephone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tab_dialpad"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/btn_phonebook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tab_contacts"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/btn_record"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tab_history"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/btn_pared"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tab_paired"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/btn_setup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/tab_settings"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
