<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/network_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/activity_bluetooth_net_info"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/setting_layout"
        android:background="@drawable/set_device_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/y402"
        android:layout_marginTop="10dp"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="27dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:textSize="30sp"
                android:textColor="@color/color_blue_dark"
                android:layout_gravity="center_vertical"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/BtSettingsLabel"
                android:layout_marginStart="61dp"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_blue_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_name_string"
                android:layout_marginStart="61dp"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_blue_dark"
                android:ellipsize="end"
                android:id="@+id/tv_edit_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bt_device_name_text"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <Button
                android:id="@+id/btn_edit_name_bt"
                android:background="@drawable/more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="61dp"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/layout_pin"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:minHeight="32dp">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/color_blue_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/device_pin_string"
                    android:layout_marginStart="61dp"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/color_blue_dark"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_edit_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/bt_device_pin_text"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
                <Button
                    android:id="@+id/btn_edit_pin_bt"
                    android:background="@drawable/more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginEnd="61dp"/>
            </LinearLayout>
            <TextView
                android:background="@drawable/line"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:minHeight="32dp">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_blue_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/autoanswer_string"
                android:layout_weight="1"
                android:layout_marginStart="61dp"/>
            <Button
                android:id="@+id/switch_autoanswer"
                android:background="@drawable/set_tumbler_off"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="61dp"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:minHeight="32dp">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_blue_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/autoconnect_string"
                android:layout_weight="1"
                android:layout_marginStart="61dp"/>
            <Button
                android:id="@+id/switch_autoconnect"
                android:background="@drawable/set_tumbler_off"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="61dp"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:minHeight="32dp">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_blue_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bluetooth_network"
                android:layout_weight="1"
                android:layout_marginStart="61dp"/>
            <Button
                android:id="@+id/network_tips"
                android:background="@drawable/network_tips"
                android:layout_width="43dp"
                android:layout_height="49dp"
                android:layout_marginEnd="16dp"/>
            <Button
                android:id="@+id/network"
                android:background="@drawable/set_tumbler_off"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:minWidth="52dp"
                android:layout_marginEnd="61dp"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="15dp"
            android:minHeight="32dp">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_blue_dark"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:text="@string/power_string"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="61dp"/>
            <Button
                android:id="@+id/switch_power"
                android:background="@drawable/set_tumbler_on"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="61dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
