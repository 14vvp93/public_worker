<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp">
        <LinearLayout
            android:background="@drawable/top_frame_bg"
            android:layout_width="340dp"
            android:layout_height="84dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="27dp">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/color_green_dark"
                android:layout_gravity="center_vertical"
                android:id="@+id/bt_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="23dp"/>
            <Button
                android:textSize="24dp"
                android:textColor="@color/color_green_dark"
                android:layout_gravity="center_vertical"
                android:id="@+id/bt_device_connected"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:singleLine="true"
                android:onClick="startMarquee"
                android:textAllCaps="false"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="367dp">
            <Button
                android:textSize="25sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_scan_bt"
                android:background="@drawable/set_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"/>
            <Button
                android:textSize="25sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_connect_bt"
                android:background="@drawable/set_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <Button
                android:textSize="25sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_disconnect_bt"
                android:background="@drawable/set_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <Button
                android:textSize="25sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_unpair_bt"
                android:background="@drawable/set_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="700dp"
            android:layout_marginTop="80dp"
            android:layout_marginStart="27dp"
            android:layout_marginEnd="30dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/set_device_bg"
                android:visibility="gone"
                android:layout_width="700dp"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:paddingStart="22dp"
                android:paddingEnd="10dp">
                <TextView
                    android:textSize="23sp"
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/BtSettingsLabel"/>
                <TextView
                    android:background="@drawable/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:minHeight="32dp">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_name_string"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#000000"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/tv_edit_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_device_name_text"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                    <Button
                        android:id="@+id/btn_edit_name_bt"
                        android:background="@drawable/more"
                        android:layout_width="32dp"
                        android:layout_height="32dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="32dp">
                    <TextView
                        android:textSize="23dp"
                        android:textColor="#000000"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/device_pin_string"/>
                    <TextView
                        android:textSize="22dp"
                        android:textColor="#000000"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_edit_pin"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_device_pin_text"
                        android:singleLine="true"/>
                    <Button
                        android:id="@+id/btn_edit_pin_bt"
                        android:background="@drawable/more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="32dp">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#000000"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/autoanswer_string"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/switch_autoanswer"
                        android:background="@drawable/set_tumbler_off"
                        android:layout_width="137dp"
                        android:layout_height="56dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="32dp">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#000000"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/autoconnect_string"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/switch_autoconnect"
                        android:background="@drawable/set_tumbler_off"
                        android:layout_width="137dp"
                        android:layout_height="56dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="32dp">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#000000"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/bluetooth_network"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/network_tips"
                        android:background="@drawable/network_tips"
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:layout_marginEnd="16dp"/>
                    <Button
                        android:id="@+id/network"
                        android:background="@drawable/set_tumbler_off"
                        android:layout_width="137dp"
                        android:layout_height="56dp"
                        android:minWidth="52dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="32dp">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#000000"
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxWidth="240dp"
                        android:text="@string/power_string"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/switch_power"
                        android:background="@drawable/set_tumbler_on"
                        android:layout_width="137dp"
                        android:layout_height="56dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/list_bg"
                android:layout_width="match_parent"
                android:layout_height="265dp"
                android:layout_marginTop="17dp">
                <TextView
                    android:textSize="23sp"
                    android:textColor="@color/color_blue_dark"
                    android:ellipsize="end"
                    android:id="@+id/paired_devices_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:maxWidth="150dp"
                    android:text="@string/paired_devices_string"
                    android:singleLine="true"
                    android:layout_marginStart="25dp"/>
                <TextView
                    android:background="@drawable/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <ListView
                    android:id="@+id/bluetooth_paired_devices"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="193dp"
                    android:listSelector="@android:color/transparent"
                    android:cacheColorHint="@android:color/transparent"
                    android:divider="@drawable/line"
                    android:dividerHeight="1dp"
                    android:choiceMode="singleChoice"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/list_bg"
                android:layout_width="match_parent"
                android:layout_height="265dp"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="23dp"
                    android:textColor="@color/color_blue_dark"
                    android:ellipsize="end"
                    android:id="@+id/usable_devices_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:maxWidth="250dp"
                    android:text="@string/usable_devices_string"
                    android:singleLine="true"
                    android:layout_marginStart="25dp"/>
                <TextView
                    android:background="@drawable/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <ListView
                    android:id="@+id/bluetooth_usable_devices"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="193dp"
                    android:listSelector="@android:color/transparent"
                    android:cacheColorHint="@android:color/transparent"
                    android:divider="@drawable/line"
                    android:dividerHeight="1dp"
                    android:choiceMode="singleChoice"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/scan_device_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_scan_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="25dp"
            android:textColor="@color/color_blue_dark"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:text="@string/scan_device"/>
    </LinearLayout>
    <include
        android:id="@+id/network_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/activity_bluetooth_net_info"/>
</FrameLayout>
