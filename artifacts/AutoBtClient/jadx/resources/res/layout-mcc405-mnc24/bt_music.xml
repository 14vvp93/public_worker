<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:background="@drawable/bg"
    android:fitsSystemWindows="true"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/llinearlayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="126dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x264">
            <ImageView
                android:background="@drawable/poster"
                android:layout_width="250dp"
                android:layout_height="248dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x55">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/music"/>
                <TextView
                    android:textSize="@dimen/x22"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_music_title"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:layout_width="@dimen/x350"
                    android:layout_height="wrap_content"
                    android:text="@string/str_music_title"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:layout_marginStart="@dimen/x22"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x29">
                <ImageView
                    android:id="@+id/iv_music_icon_album"
                    android:visibility="visible"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/album"/>
                <TextView
                    android:textSize="@dimen/x22"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_music_icon_album"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:layout_width="@dimen/x240"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:layout_marginStart="@dimen/x22"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x29">
                <ImageView
                    android:id="@+id/iv_music_icon_artist"
                    android:visibility="visible"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/actors"/>
                <TextView
                    android:textSize="@dimen/x22"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_music_icon_artist"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:layout_width="@dimen/x240"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:layout_marginStart="@dimen/x22"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x15">
            <ImageView
                android:id="@+id/bt_connect_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x15"
                android:layout_marginStart="@dimen/x5">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x30"
                    android:layout_marginStart="0dp">
                    <TextView
                        android:textSize="@dimen/x16"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_a2dp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/x5"
                        android:text="@string/a2dp_status_title"/>
                    <TextView
                        android:textSize="@dimen/x16"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_A2DP_status"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/x5"
                        android:layout_marginStart="0dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp">
                    <TextView
                        android:textSize="@dimen/x16"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_avrcp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/x5"
                        android:text="@string/avrcp_status_title"
                        android:layout_marginStart="0dp"/>
                    <TextView
                        android:textSize="@dimen/x16"
                        android:textColor="@android:color/white"
                        android:id="@+id/tv_AVRCP_status"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/x5"
                        android:layout_marginStart="0dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/llinearlayout2"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="110dp"
        android:layout_below="@+id/llinearlayout1">
        <TextView
            android:textSize="@dimen/x20"
            android:id="@+id/tv_music_play_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_playing_time"/>
        <SeekBar
            android:id="@+id/tv_music_playing_progress"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="1002dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-3dp"
            android:maxHeight="6dp"
            android:progressDrawable="@drawable/seekbar_bg"
            android:minHeight="6dp"
            android:thumb="@drawable/progress_thumb"
            android:paddingStart="@dimen/x15"
            android:paddingEnd="@dimen/x15"
            android:splitTrack="false"/>
        <TextView
            android:textSize="@dimen/x20"
            android:id="@+id/tv_music_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_total_time"/>
    </LinearLayout>
    <Button
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="110dp"
        android:layout_below="@+id/llinearlayout1"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/y81"
        android:layout_alignParentBottom="true">
        <Button
            android:id="@+id/btn_music_prev"
            android:background="@drawable/music_prev"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginEnd="@dimen/x160"/>
        <Button
            android:id="@+id/btn_music_pause"
            android:background="@drawable/music_pause"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <Button
            android:id="@+id/btn_music_play"
            android:background="@drawable/music_play"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <Button
            android:id="@+id/btn_music_next"
            android:background="@drawable/music_next"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginStart="@dimen/x160"/>
        <Button
            android:id="@+id/btn_music_eq"
            android:background="@drawable/music_eq"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
    </LinearLayout>
</RelativeLayout>
