<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/x23"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/x46"
    android:paddingEnd="@dimen/x46">
    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:background="@drawable/network_top_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView1"
                android:background="@drawable/bluetooth_setup_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x20"/>
            <TextView
                android:textSize="@dimen/x23"
                android:textColor="@color/bluetooth_net_text_color"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/info1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/x600"
                android:text="@string/title_1"
                android:maxLines="1"
                android:layout_marginStart="@dimen/x30"/>
            <TextView
                android:textSize="@dimen/x24"
                android:textColor="@color/bluetooth_net_text_color"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/info2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/x600"
                android:text="@string/title_2"
                android:maxLines="1"
                android:layout_marginStart="@dimen/x30"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/x23"
            android:textColor="@color/bluetooth_close_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tips_close"
            android:background="@drawable/set_btn_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/x120"
            android:text="@string/next"
            android:maxLines="1"
            android:singleLine="true"
            android:shadowRadius="0.6"
            android:layout_marginStart="@dimen/x24"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/x24"
        android:layout_marginBottom="@dimen/x20"
        android:layout_below="@+id/linearLayout1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/relativeLayout1"
            android:background="@drawable/set_device_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:divider="@drawable/line"
            android:layout_weight="1"
            android:showDividers="end|middle">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y50"
                android:paddingStart="@dimen/x51">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imageView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bluetooth_android"/>
                <TextView
                    android:textSize="@dimen/x24"
                    android:textColor="@color/bluetooth_net_text_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/android_system"
                    android:layout_marginStart="@dimen/x10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y54"
                android:layout_marginStart="@dimen/x93">
                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bluetooth_bt_info"/>
                <TextView
                    android:textSize="@dimen/x20"
                    android:textColor="@color/dial_name_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/openphonebluetoot"
                    android:layout_marginStart="@dimen/x14"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y54"
                android:layout_marginStart="@dimen/x93">
                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bluetooth_input_info"/>
                <TextView
                    android:textSize="@dimen/x20"
                    android:textColor="@color/dial_name_color"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/x320"
                    android:text="@string/inputnetwork"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/x14"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y54"
                android:layout_marginStart="@dimen/x93">
                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bluetooth_open_info"/>
                <TextView
                    android:textSize="@dimen/x20"
                    android:textColor="@color/dial_name_color"
                    android:ellipsize="end"
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/x320"
                    android:text="@string/openbtnewshare"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/x14"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/relativeLayout2"
            android:background="@drawable/set_device_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:divider="@drawable/line"
            android:layout_weight="1"
            android:showDividers="end|middle"
            android:layout_marginStart="@dimen/x24">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y50"
                android:paddingStart="@dimen/x51">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/imageView2_r"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bluetooth_apple"/>
                <TextView
                    android:textSize="@dimen/x24"
                    android:textColor="@color/bluetooth_net_text_color"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/textView1_r"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ios_system"
                    android:layout_marginStart="@dimen/x10"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y54"
                android:layout_marginStart="@dimen/x93">
                <ImageView
                    android:id="@+id/imageView3_r"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bluetooth_bt_info"/>
                <TextView
                    android:textSize="@dimen/x20"
                    android:textColor="@color/dial_name_color"
                    android:ellipsize="end"
                    android:id="@+id/textView2_r"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/x320"
                    android:text="@string/openphonebluetoot"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/x14"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/y54"
                android:layout_marginStart="@dimen/x93">
                <ImageView
                    android:id="@+id/imageView4_r"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bluetooth_wifi_info"/>
                <TextView
                    android:textSize="@dimen/x20"
                    android:textColor="@color/dial_name_color"
                    android:ellipsize="end"
                    android:id="@+id/textView3_r"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/x320"
                    android:text="@string/openapplenet"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/x14"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
