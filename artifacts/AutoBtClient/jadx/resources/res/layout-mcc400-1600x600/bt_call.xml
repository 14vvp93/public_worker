<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/y5"
        android:layout_marginStart="@dimen/x80">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/y10">
            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layoutDirection="ltr">
                <TableRow
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_one"
                        android:background="@drawable/dp_one"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"/>
                    <Button
                        android:id="@+id/btn_call_two"
                        android:background="@drawable/dp_two"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                    <Button
                        android:id="@+id/btn_call_three"
                        android:background="@drawable/dp_three"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_four"
                        android:background="@drawable/dp_four"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"/>
                    <Button
                        android:id="@+id/btn_call_five"
                        android:background="@drawable/dp_five"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                    <Button
                        android:id="@+id/btn_call_six"
                        android:background="@drawable/dp_six"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                </TableRow>
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_seven"
                        android:background="@drawable/dp_seven"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"/>
                    <Button
                        android:id="@+id/btn_call_eight"
                        android:background="@drawable/dp_eight"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                    <Button
                        android:id="@+id/btn_call_nine"
                        android:background="@drawable/dp_nine"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                </TableRow>
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:id="@+id/btn_call_pound"
                        android:background="@drawable/dp_sharp"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"/>
                    <Button
                        android:id="@+id/btn_call_zero"
                        android:background="@drawable/dp_zero"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                    <Button
                        android:id="@+id/btn_call_asterisk"
                        android:background="@drawable/dp_star"
                        android:layout_width="@dimen/x100"
                        android:layout_height="@dimen/x71"
                        android:layout_marginStart="@dimen/x25"/>
                </TableRow>
            </TableLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/set_device_bg"
            android:paddingTop="@dimen/x10"
            android:paddingBottom="@dimen/x15"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x284"
            android:layout_marginTop="@dimen/x10"
            android:paddingStart="@dimen/x12"
            android:paddingEnd="@dimen/x12"
            android:layout_marginStart="@dimen/x60"
            android:layout_marginEnd="@dimen/x80">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x50"
                android:layout_marginStart="@dimen/x20"
                android:layout_marginEnd="@dimen/x20">
                <EditText
                    android:textSize="@dimen/y50"
                    android:textColor="@color/color_blue_dark"
                    android:gravity="center_vertical"
                    android:id="@+id/text_call_info"
                    android:background="@android:color/transparent"
                    android:paddingTop="@dimen/y5"
                    android:layout_width="@dimen/x330"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/x20"/>
                <Button
                    android:layout_gravity="center"
                    android:id="@+id/btn_del_num"
                    android:background="@drawable/backspace"
                    android:layout_width="@dimen/x48"
                    android:layout_height="@dimen/x48"/>
            </LinearLayout>
            <TextView
                android:background="@drawable/line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"/>
            <ListView
                android:id="@+id/listview_calls"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x140"
                android:divider="@drawable/line"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x10">
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btn_call"
                    android:background="@drawable/call"
                    android:layout_width="@dimen/x50"
                    android:layout_height="@dimen/x50"
                    android:layout_marginBottom="@dimen/x35"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
