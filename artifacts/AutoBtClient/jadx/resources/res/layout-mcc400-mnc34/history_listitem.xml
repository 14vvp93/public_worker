<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="@dimen/y79"
        android:layout_height="@dimen/y79"
        android:layout_marginTop="@dimen/x15"
        android:src="@drawable/contact"
        android:layout_marginStart="@dimen/x15"/> /&gt; 
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/history_item"
        android:paddingBottom="0dp"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/x5">
        <TextView
            android:textSize="@dimen/x18"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:layout_gravity="top"
            android:id="@+id/item_history_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y15"
            android:singleLine="true"
            android:layout_marginStart="@dimen/x5"/>
        <TextView
            android:textSize="@dimen/x15"
            android:textColor="@color/color_white_light"
            android:ellipsize="end"
            android:layout_gravity="bottom"
            android:id="@+id/item_history_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y4"
            android:singleLine="true"
            android:layout_marginStart="@dimen/x5"/>
        <TextView
            android:textSize="@dimen/x15"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:id="@+id/item_history_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <ImageView
            android:id="@+id/btn_call_history_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/contact"
            android:layout_marginEnd="@dimen/x3"/>
    </LinearLayout>
</LinearLayout>
