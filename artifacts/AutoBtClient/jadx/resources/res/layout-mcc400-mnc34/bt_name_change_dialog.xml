<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bt_name_bg"
    android:padding="0dp"
    android:fitsSystemWindows="true"
    android:layout_width="@dimen/x400"
    android:layout_height="@dimen/y200">
    <TextView
        android:textSize="@dimen/x20"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x10"
        android:text="@string/bt_device_info"
        android:layout_marginStart="@dimen/x14"
        android:layout_marginEnd="@dimen/x35"/>
    <TextView
        android:textSize="@dimen/x16"
        android:textColor="#cc000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bt_device_name_title"
        android:layout_marginStart="@dimen/x14"
        android:layout_marginEnd="@dimen/x35"/>
    <EditText
        android:textSize="@dimen/x20"
        android:textColor="#000000"
        android:textColorHint="@color/color_bt_history_item_light"
        android:gravity="start"
        android:id="@+id/edit_bt_name"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/y20"
        android:singleLine="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="flagNoFullscreen|actionDone"
        android:layout_marginStart="@dimen/x14"
        android:layout_marginEnd="@dimen/x14"/>
    <ImageView
        android:background="#009688"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x2"
        android:layout_marginStart="@dimen/x14"
        android:layout_marginEnd="@dimen/x14"/>
    <LinearLayout
        android:gravity="end|bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/y20"
        android:layout_marginBottom="@dimen/y20">
        <Button
            android:textSize="@dimen/x16"
            android:textColor="#009688"
            android:gravity="center"
            android:id="@+id/bt_name_confirm"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/y30"
            android:text="@android:string/ok"
            android:textAllCaps="false"/>
        <Button
            android:textSize="@dimen/x16"
            android:textColor="#009688"
            android:gravity="center"
            android:id="@+id/bt_name_cancel"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/y30"
            android:text="@android:string/cancel"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
