<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginTop="@dimen/bt_call_layout_marginTop" android:layout_marginStart="@dimen/bt_phonebook_layout_marginStart" android:layout_marginEnd="@dimen/bt_phonebook_layout_marginStart">
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <EditText android:textSize="@dimen/bt_phonebook_search_edittext_textSize" android:textColor="@color/color_blue_dark" android:textColorHint="@color/color_blue_dark" android:layout_gravity="center_vertical" android:id="@id/search_edittext" android:background="@android:color/transparent" android:layout_width="@dimen/bt_phonebook_search_edittext_layout_width" android:layout_height="wrap_content" android:singleLine="true" android:imeOptions="actionDone|flagNoFullscreen" />
            <Button android:id="@id/bt_phonebook_syn" android:background="@drawable/sync" android:layout_width="@dimen/bt_phonebook_bt_phonebook_syn_layout_width" android:layout_height="@dimen/bt_phonebook_bt_phonebook_syn_layout_height" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <GridView android:id="@id/phonebook_listview" android:layout_width="@dimen/bt_phonebook_phonebook_listview_layout_width" android:layout_height="@dimen/bt_phonebook_phonebook_listview_layout_height" android:layout_marginTop="@dimen/bt_phonebook_phonebook_listview_layout_marginTop" android:listSelector="@android:color/transparent" android:verticalSpacing="@dimen/bt_phonebook_phonebook_listview_verticalSpacing" android:stretchMode="columnWidth" android:numColumns="@integer/bt_phonebook_phonebook_listview_numColumns" android:choiceMode="singleChoice" android:layout_marginStart="@dimen/bt_phonebook_phonebook_listview_layout_marginStart" android:layout_marginEnd="@dimen/bt_phonebook_phonebook_listview_layout_marginStart" />
            <com.autochips.bluetooth.view.SideBar android:id="@id/phonebook_sidebar" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_marginTop="@dimen/bt_phonebook_phonebook_sidebar_layout_marginTop" android:layout_marginStart="@dimen/bt_phonebook_phonebook_sidebar_layout_marginStart" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_gravity="center" android:orientation="horizontal" android:id="@id/download_phonebook_layout" android:background="@drawable/dialog_bg" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ProgressBar android:id="@id/progressbar_download_phonebook" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/x15" android:indeterminateDrawable="@drawable/blue_progressbar" />
        <TextView android:textSize="@dimen/dial_listitem_dial_name_textSize" android:textColor="@color/callhistory_download_text" android:layout_gravity="center_vertical" android:id="@id/tv_download_phonebook_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_download_phonebook" android:layout_marginEnd="@dimen/x15" />
    </LinearLayout>
</FrameLayout>