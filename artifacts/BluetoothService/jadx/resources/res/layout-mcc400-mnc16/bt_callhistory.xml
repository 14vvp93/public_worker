<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/x1024"
    android:layout_height="@dimen/y600">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/x40"
        android:layout_marginEnd="@dimen/x40">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/x180">
                <RadioButton
                    android:id="@+id/btn_missed"
                    android:background="@drawable/missed"
                    android:layout_width="@dimen/btn_missed_layout_width"
                    android:layout_height="@dimen/btn_missed_layout_height"
                    android:layout_marginTop="@dimen/y5"
                    android:button="@null"/>
                <RadioButton
                    android:id="@+id/btn_received"
                    android:background="@drawable/received"
                    android:layout_width="@dimen/btn_missed_layout_width"
                    android:layout_height="@dimen/btn_missed_layout_height"
                    android:layout_marginTop="5dp"
                    android:button="@null"
                    android:layout_marginStart="10dp"/>
                <RadioButton
                    android:id="@+id/btn_dialed"
                    android:background="@drawable/called"
                    android:layout_width="@dimen/btn_missed_layout_width"
                    android:layout_height="@dimen/btn_missed_layout_height"
                    android:layout_marginTop="5dp"
                    android:button="@null"
                    android:layout_marginStart="10dp"/>
                <RadioButton
                    android:id="@+id/bt_callhistory_syn"
                    android:background="@drawable/sync"
                    android:layout_width="@dimen/btn_missed_layout_width"
                    android:layout_height="@dimen/btn_missed_layout_height"
                    android:layout_marginTop="5dp"
                    android:button="@null"
                    android:layout_marginStart="10dp"/>
            </RadioGroup>
            <GridView
                android:id="@+id/history_listview"
                android:padding="@dimen/x5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="@android:color/transparent"
                android:verticalSpacing="@dimen/x16"
                android:stretchMode="columnWidth"
                android:numColumns="@integer/history_listview_numColumns"
                android:choiceMode="singleChoice"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/download_callhistory_layout"
        android:background="@drawable/dialog_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progressbar_download_callhistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x16"
            android:indeterminateDrawable="@drawable/blue_progressbar"/>
        <TextView
            android:textSize="@dimen/x30"
            android:textColor="@color/callhistory_download_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_download_callhistory_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_download_history"
            android:layout_marginEnd="@dimen/x16"/>
    </LinearLayout>
</FrameLayout>
