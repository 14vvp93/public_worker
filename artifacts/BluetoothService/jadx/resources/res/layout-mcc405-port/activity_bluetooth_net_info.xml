<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/network_top_bg"
            android:layout_width="450dp"
            android:layout_height="66dp">
            <ImageView
                android:background="@drawable/bluetooth_setup_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/bt_connect_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_1"
                android:singleLine="true"
                android:layout_marginStart="12dp"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/bluetooth_net_text_color"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_2"
                android:singleLine="true"
                android:layout_marginStart="30dp"/>
        </LinearLayout>
        <Button
            android:textSize="24sp"
            android:textColor="@color/bluetooth_close_text_color"
            android:id="@+id/tips_close"
            android:background="@drawable/set_btn_selector"
            android:layout_width="146dp"
            android:layout_height="66dp"
            android:text="@string/next"
            android:singleLine="true"
            android:layout_marginStart="90dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/setting_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:divider="@drawable/list_line"
        android:layout_weight="1"
        android:showDividers="end|middle">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_android"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/bluetooth_close_text_color"
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/android_system"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_bt_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_close_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openphonebluetoot"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_input_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_close_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inputnetwork"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_open_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_close_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openbtnewshare"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/setting_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@drawable/list_line"
        android:layout_weight="1"
        android:showDividers="end|middle">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_apple"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/bluetooth_close_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ios_system"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:src="@drawable/bluetooth_bt_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_close_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openphonebluetoot"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bluetooth_wifi_info"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/bluetooth_close_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openapplenet"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
