<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/x20"
    android:paddingBottom="@dimen/x20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/x20"
    android:paddingEnd="@dimen/x20">
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/x20"
        android:paddingEnd="@dimen/x20">
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_call_one"
                android:background="@drawable/dp_one"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_two"
                android:background="@drawable/dp_two"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_three"
                android:background="@drawable/dp_three"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btn_call_four"
                android:background="@drawable/dp_four"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_five"
                android:background="@drawable/dp_five"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_six"
                android:background="@drawable/dp_six"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btn_call_seven"
                android:background="@drawable/dp_seven"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_eight"
                android:background="@drawable/dp_eight"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_nine"
                android:background="@drawable/dp_nine"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
        </TableRow>
        <TableRow
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btn_call_pound"
                android:background="@drawable/dp_sharp"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_zero"
                android:background="@drawable/dp_zero"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_call_asterisk"
                android:background="@drawable/dp_star"
                android:layout_width="@dimen/x190"
                android:layout_height="wrap_content"/>
        </TableRow>
    </TableLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/set_device_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:divider="@drawable/line"
        android:layout_weight="1"
        android:showDividers="middle"
        android:paddingStart="@dimen/x20"
        android:paddingEnd="@dimen/x20">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="66dp">
            <EditText
                android:textSize="35sp"
                android:textColor="@android:color/white"
                android:id="@+id/text_call_info"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="30dp"/>
            <Button
                android:id="@+id/btn_del_num"
                android:background="@drawable/backspace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
        <ListView
            android:id="@+id/listview_calls"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:listSelector="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@drawable/line"
            android:choiceMode="singleChoice"
            android:layout_weight="1"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_call"
            android:background="@drawable/call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x10"/>
    </LinearLayout>
</LinearLayout>
