<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_main"
    android:background="@drawable/bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/set_device_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="37dp"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="38dp">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/poster_shadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp">
                <ImageView
                    android:background="@drawable/poster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginStart="5dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/music"/>
                    <TextView
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#dbdbdb"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_music_title"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:layout_width="@dimen/y196"
                        android:layout_height="wrap_content"
                        android:text="@string/str_music_title"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginStart="22dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <ImageView
                        android:id="@+id/iv_music_icon_album"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/album"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#dbdbdb"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_music_icon_album"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:layout_width="@dimen/y196"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginStart="22dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <ImageView
                        android:id="@+id/iv_music_icon_artist"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/actors"/>
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#dbdbdb"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_music_icon_artist"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:layout_width="@dimen/y196"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginStart="22dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textColor="@android:color/white"
                android:id="@+id/tv_music_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_playing_time"
                android:layout_marginEnd="4dp"/>
            <ProgressBar
                android:id="@+id/tv_music_playing_progress"
                android:layout_width="@dimen/y367"
                android:layout_height="30dp"
                android:progressDrawable="@drawable/seekbar_bg"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#50f2f2f2"
                android:id="@+id/tv_music_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_total_time"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp">
            <Button
                android:id="@+id/btn_music_prev"
                android:background="@drawable/music_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/btn_music_pause"
                android:background="@drawable/music_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"/>
            <Button
                android:id="@+id/btn_music_play"
                android:background="@drawable/music_play"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"/>
            <Button
                android:id="@+id/btn_music_next"
                android:background="@drawable/music_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp">
        <ImageView
            android:id="@+id/bt_connect_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_a2dp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/a2dp_status_title"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_A2DP_status"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_avrcp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/avrcp_status_title"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_AVRCP_status"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
