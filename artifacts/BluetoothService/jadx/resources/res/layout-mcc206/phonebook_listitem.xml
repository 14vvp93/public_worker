<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/contact"
        android:layout_marginStart="15dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/phonebook_item"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp">
        <TextView
            android:textSize="@dimen/item_history_name_textSize"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:id="@+id/item_phonebook_name"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:maxWidth="250dp"
            android:text="shabi"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/item_history_name_textSize"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:id="@+id/item_phonebook_number"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x300"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:maxWidth="250dp"
            android:text="shabi"
            android:singleLine="true"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_phonebook_path"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bt_phonebook_path_phone"/>
    </LinearLayout>
</LinearLayout>
