<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="@dimen/x52"
        android:layout_height="@dimen/x52"
        android:src="@drawable/contact"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/phonebook_item"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x6">
        <TextView
            android:textSize="@dimen/x17"
            android:textColor="@color/color_blue_dark"
            android:ellipsize="end"
            android:id="@+id/item_phonebook_name"
            android:layout_width="@dimen/x222"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/x15"
            android:textColor="@color/color_white_light"
            android:ellipsize="end"
            android:id="@+id/item_phonebook_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_phonebook_path"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bt_phonebook_path_phone"/>
    </LinearLayout>
</LinearLayout>
