<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="5dp"
    android:layout_marginStart="74dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TableLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">
            <TableRow
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btn_call_one"
                    android:background="@drawable/dp_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/btn_call_two"
                    android:background="@drawable/dp_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
                <Button
                    android:id="@+id/btn_call_three"
                    android:background="@drawable/dp_three"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <Button
                    android:id="@+id/btn_call_four"
                    android:background="@drawable/dp_four"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/btn_call_five"
                    android:background="@drawable/dp_five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
                <Button
                    android:id="@+id/btn_call_six"
                    android:background="@drawable/dp_six"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
            </TableRow>
            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <Button
                    android:id="@+id/btn_call_seven"
                    android:background="@drawable/dp_seven"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/btn_call_eight"
                    android:background="@drawable/dp_eight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
                <Button
                    android:id="@+id/btn_call_nine"
                    android:background="@drawable/dp_nine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
            </TableRow>
            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <Button
                    android:id="@+id/btn_call_pound"
                    android:background="@drawable/dp_sharp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"/>
                <Button
                    android:id="@+id/btn_call_zero"
                    android:background="@drawable/dp_zero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
                <Button
                    android:id="@+id/btn_call_asterisk"
                    android:background="@drawable/dp_star"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
            </TableRow>
        </TableLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/set_device_bg"
        android:layout_width="620dp"
        android:layout_height="280dp"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <EditText
                android:textSize="30sp"
                android:textColor="@color/color_blue_dark"
                android:gravity="center_vertical"
                android:id="@+id/text_call_info"
                android:background="@android:color/transparent"
                android:paddingTop="5dp"
                android:layout_width="500dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="20dp"/>
            <Button
                android:layout_gravity="center"
                android:id="@+id/btn_del_num"
                android:background="@drawable/backspace"
                android:layout_width="50dp"
                android:layout_height="50dp"/>
        </LinearLayout>
        <TextView
            android:background="@drawable/line"
            android:layout_width="600dp"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="17dp"/>
        <ListView
            android:id="@+id/listview_calls"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:divider="@drawable/line"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_call"
            android:background="@drawable/call"
            android:layout_width="95dp"
            android:layout_height="95dp"/>
    </LinearLayout>
</LinearLayout>
