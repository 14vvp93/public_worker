<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="@dimen/x84"
            android:layout_height="@dimen/x84"
            android:src="@drawable/contact"
            android:layout_marginStart="@dimen/x10"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/phonebook_item"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/x5">
            <TextView
                android:textSize="@dimen/x24"
                android:textColor="@color/color_blue_dark"
                android:ellipsize="end"
                android:id="@+id/item_phonebook_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="@dimen/x10"/>
            <TextView
                android:textSize="@dimen/x20"
                android:textColor="@color/color_white_light"
                android:ellipsize="end"
                android:id="@+id/item_phonebook_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="@dimen/x10"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_phonebook_path"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bt_phonebook_path_phone"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/y1"
        android:layout_marginTop="@dimen/y5"/>
</LinearLayout>
